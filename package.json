  "version": "0.1.1",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "description": "Folder as a Service CLI: turn folders into named knowledge endpoints — one stable command surface, on this machine or your own server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CatheadOwl/ukp.git"
  },
  "homepage": "https://github.com/CatheadOwl/ukp#readme",
  "bugs": {
